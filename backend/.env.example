# Django Environment Variables Example
SECRET_KEY=django-insecure-hostelease-int253-syllabus-super-secret-key-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Defaults to SQLite if DB_ENGINE is empty or 'sqlite')
# Options: 'sqlite' or 'mysql'
DB_ENGINE=sqlite

# Optional MySQL Settings:
DB_NAME=hostelease_db
DB_USER=root
DB_PASSWORD=your_password
DB_HOST=127.0.0.1
DB_PORT=3306

# CORS & Frontend Origin
FRONTEND_URL=http://localhost:5173
